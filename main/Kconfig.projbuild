menu "PulseNest board"

    # The IncuNest board revision PulseNest runs on. Up to V18 only the DRDY pin and the name
    # reported in $CFG differ between revisions; V19 also moves PWDN and gates two power rails
    # (see docs/boards.md). The SPI bus and CS are common to every revision.
    # Replaces PlatformIO's one-environment-per-board (-DAFE4490_DRDY_PIN, -DBOARD_VERSION).
    choice PULSENEST_BOARD
        prompt "IncuNest board revision"
        default PULSENEST_BOARD_V18

        config PULSENEST_BOARD_V15
            bool "IncuNest V15 (DRDY on GPIO45)"
        config PULSENEST_BOARD_V16
            bool "IncuNest V16 (DRDY on GPIO17)"
        config PULSENEST_BOARD_V17
            bool "IncuNest V17 (DRDY on GPIO17)"
        config PULSENEST_BOARD_V18
            bool "IncuNest V18 (DRDY on GPIO17)"
        config PULSENEST_BOARD_V19
            bool "IncuNest V19 (DRDY on GPIO17, PWDN on GPIO7, 5 V rail enabled by GPIO40)"
    endchoice

    config PULSENEST_BOARD_VERSION
        string
        default "incunest_V15" if PULSENEST_BOARD_V15
        default "incunest_V16" if PULSENEST_BOARD_V16
        default "incunest_V17" if PULSENEST_BOARD_V17
        default "incunest_V18" if PULSENEST_BOARD_V18
        default "incunest_V19" if PULSENEST_BOARD_V19

    config PULSENEST_AFE_DRDY_PIN
        int
        default 45 if PULSENEST_BOARD_V15
        default 17

    # Common to every revision. Kept as Kconfig ints rather than literals in the source so the
    # pin map lives in one place (project rule: pins from a single dictionary, never hardcoded).
    config PULSENEST_SPI_SCK_PIN
        int "AFE4490 SPI SCK GPIO"
        default 36
    config PULSENEST_SPI_MISO_PIN
        int "AFE4490 SPI MISO GPIO"
        default 37
    config PULSENEST_SPI_MOSI_PIN
        int "AFE4490 SPI MOSI GPIO"
        default 35
    config PULSENEST_AFE_CS_PIN
        int "AFE4490 chip-select GPIO"
        default 21
    # V19: AFE_PDN moved to GPIO7 (R24). Up to V18 the AFE's PDN is not wired to a GPIO and GPIO0
    # (the BOOT strap) is pulsed harmlessly; on V19 GPIO0 is the BOOT button S2 and header J1.
    config PULSENEST_AFE_PWDN_PIN
        int "AFE4490 PWDN GPIO"
        default 7 if PULSENEST_BOARD_V19
        default 0

    # V19 power rails, both off at reset (73k2 pull-downs on the EN pins of the TPS563231 bucks).
    # The 5 V rail feeds the AFE's LED driver (TX supply) and the 3v3_ANA LDO (the AFE's RX supply),
    # so the AFE cannot run until the firmware enables it. -1 = no such rail on this revision.
    config PULSENEST_PWR_5V_EN_PIN
        int "5 V rail enable GPIO (-1 = not gated)"
        default 40 if PULSENEST_BOARD_V19
        default -1
    # SIM800C supply (VBAT buck). PulseNest has no use for the modem: it is held off on purpose.
    config PULSENEST_GSM_PWR_EN_PIN
        int "GSM modem supply enable GPIO (-1 = not gated)"
        default 39 if PULSENEST_BOARD_V19
        default -1

endmenu
